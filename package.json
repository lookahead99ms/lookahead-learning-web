{
  "name": "lookahead-learning-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "content:sync": "node scripts/sync-runtime-content.mjs demo-content/runtime",
    "content:sync:dev": "node scripts/sync-runtime-content.mjs --development",
    "content:sync:private": "node scripts/sync-runtime-content.mjs --external",
    "content:sync:fixture": "node scripts/sync-runtime-content.mjs test-fixtures/content",
    "prestart": "npm run content:sync:dev",
    "start": "ng serve",
    "start:private": "node scripts/start-private.mjs",
    "prebuild": "npm run content:sync",
    "build": "ng build",
    "prebuild:private": "npm run content:sync:private",
    "build:private": "ng build",
    "prebuild:ci": "npm run content:sync",
    "build:ci": "ng build",
    "prewatch": "npm run content:sync",
    "watch": "ng build --watch --configuration development",
    "prewatch:private": "npm run content:sync:private",
    "watch:private": "ng build --watch --configuration development",
    "test": "ng test",
    "test:delivery-api": "node --test scripts/delivery-editor.test.mjs",
    "test:content-audit": "node --test scripts/audit-content.test.mjs",
    "test:dsa-profile": "node --test scripts/profile-dsa-loading.test.mjs",
    "profile:dsa": "node scripts/profile-dsa-loading.mjs",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:content:private": "node scripts/audit-content.mjs --external",
    "validate:content": "node scripts/validate-content.mjs demo-content/runtime",
    "validate:content:private": "node scripts/validate-content.mjs --external",
    "validate:content:fixture": "node scripts/validate-content.mjs test-fixtures/content",
    "validate:content:ci": "npm run validate:content:fixture",
    "validate:source-boundary": "node scripts/validate-source-boundary.mjs",
    "validate:public-readiness": "node scripts/verify-public-release.mjs",
    "prepare:public-snapshot": "node scripts/prepare-public-snapshot.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "marked": "18.0.11",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
